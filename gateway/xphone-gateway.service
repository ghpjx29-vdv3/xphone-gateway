[Unit]
Description=XPhone Gateway (agent WebSocket client)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=HOME=/home/hatch
Environment=XPHONE_PROVIDER=muse
EnvironmentFile=/home/hatch/xphone/gateway/proxy.env
WorkingDirectory=/home/hatch/xphone/gateway
ExecStart=/home/hatch/xphone/gateway/.venv/bin/python /home/hatch/xphone/gateway/gateway.py
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
StandardOutput=append:/home/hatch/xphone/gateway/gateway.log
StandardError=inherit

[Install]
WantedBy=default.target
